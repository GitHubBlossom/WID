# Google OAuth Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/
# Create OAuth 2.0 Client ID and download credentials
GOOGLE_CREDENTIALS_FILE=credentials.json

# Anthropic API Key for AI Summarization
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Scheduler Configuration
# Time to run the report (24-hour format)
SCHEDULE_DAY=sunday
SCHEDULE_HOUR=18
SCHEDULE_MINUTE=0

# Timezone (e.g., America/New_York, Europe/London, Asia/Tokyo)
TIMEZONE=America/New_York

# Report Configuration
REPORT_OUTPUT_DIR=reports
REPORT_FORMAT=markdown
# Options: markdown, html, pdf, txt

# Days to look back for activity
LOOKBACK_DAYS=7

# Email settings (optional - for sending reports)
SEND_EMAIL=false
RECIPIENT_EMAIL=your_email@example.com
